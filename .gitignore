Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
PackagedBuilds/

# Editor metadata
.vscode/

# Binary assets not tracked via Git LFS
Content/Collections/
Content/Developers/
Content/*.uasset
# Level maps — CourtLevel.umap is tracked, others are not
Content/*.umap
!Content/CourtLevel.umap

# IDE and compiler artifacts
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo
*.sln
*.xcworkspace
*.xcodeproj
Config/DefaultEditor.ini
Script/Binds.Cache*

# Android signing — generated at CI time from GitHub Secrets, never committed.
# (Build/ above already covers Build/Android/*.keystore; these are belt-and-suspenders.)
Config/Android/AndroidEngine.ini
*.keystore
*.jks

# Python bytecode
__pycache__/
*.pyc
