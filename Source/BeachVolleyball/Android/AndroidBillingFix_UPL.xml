<?xml version="1.0" encoding="utf-8"?>
<!--
  This project has no in-app purchases and doesn't reference Play Billing
  directly. Play Console's pre-launch checks still flag an outdated
  com.android.billingclient:billing AIDL version pulled in transitively by
  one of the engine's bundled Android Gradle dependencies. Force-resolve it
  to a compliant version (Play requires >= 6.0.1) rather than tracking down
  which transitive dependency drags in the old one.
-->
<root xmlns:android="http://schemas.android.com/apk/res/android">
  <baseBuildGradleAdditions>
    <insert>
      allprojects {
          configurations.all {
              resolutionStrategy {
                  force 'com.android.billingclient:billing:6.2.1'
              }
          }
      }
    </insert>
  </baseBuildGradleAdditions>
</root>
